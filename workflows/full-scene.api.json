{
  "source": {
    "class_type": "ZuraPaintoutFullFrame",
    "inputs": {
      "plate_path": "C:/path/to/plate.mp4",
      "colour_space": "srgb_display",
      "start_frame": 0,
      "frame_count": 81,
      "sequence_fps": 25,
      "context_pixels": 128,
      "max_crop_side": 768,
      "repair_grow": 0,
      "feather_pixels": 0,
      "processing_mode": "SDR (sRGB)",
      "framing_mode": "Plate resolution (stretch to next grid)",
      "render_width": 1920,
      "render_height": 1088
    },
    "_meta": {
      "title": "Reading footage and preparing frames"
    }
  },
  "model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Loading LTX 2.5"
    }
  },
  "lora": {
    "class_type": "LTXICLoRALoaderModelOnly",
    "inputs": {
      "model": [
        "model",
        0
      ],
      "lora_name": "ltx-2.5-22b-ic-lora-clean-plate-1.0.safetensors",
      "strength_model": 1
    },
    "_meta": {
      "title": "Loading the paintout adapter"
    }
  },
  "memory": {
    "class_type": "ZuraPaintoutGuideMemory",
    "inputs": {
      "model": [
        "lora",
        0
      ],
      "query_chunk": 1024
    },
    "_meta": {
      "title": "Preparing guide attention"
    }
  },
  "text": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "type": "ltxv",
      "device": "default"
    },
    "_meta": {
      "title": "Loading the text encoder"
    }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "text",
        0
      ],
      "text": "An empty clean plate of the same scene, without people, vehicles or moving obstructions. Preserve the static background, architecture, lighting, perspective and original camera movement."
    },
    "_meta": {
      "title": "Encoding the prompt"
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "text",
        0
      ],
      "text": "people, person, pedestrian, human, cyclist, car, taxi, vehicle, bicycle, ghosting, blurry, distorted, jitter"
    },
    "_meta": {
      "title": "Encoding the prompt"
    }
  },
  "video_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-video-vae-conv-bf16.safetensors"
    },
    "_meta": {
      "title": "Loading the video VAE"
    }
  },
  "float_vae": {
    "class_type": "LTXVVAEForceFloat32",
    "inputs": {
      "vae": [
        "video_vae",
        0
      ]
    },
    "_meta": {
      "title": "Preparing float32 precision"
    }
  },
  "audio_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
    },
    "_meta": {
      "title": "Loading the audio VAE"
    }
  },
  "take": {
    "class_type": "ZuraPaintoutTake",
    "inputs": {
      "plate": [
        "source",
        2
      ]
    },
    "_meta": {
      "title": "Reading the selected frames"
    }
  },
  "conditioning": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": [
        "positive",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "frame_rate": [
        "take",
        5
      ]
    },
    "_meta": {
      "title": "Preparing conditioning"
    }
  },
  "latent": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": [
        "take",
        2
      ],
      "height": [
        "take",
        3
      ],
      "length": [
        "take",
        4
      ],
      "batch_size": 1
    },
    "_meta": {
      "title": "Preparing video samples"
    }
  },
  "guide": {
    "class_type": "LTXAddVideoICLoRAGuideAdvanced",
    "inputs": {
      "positive": [
        "conditioning",
        0
      ],
      "negative": [
        "conditioning",
        1
      ],
      "vae": [
        "float_vae",
        0
      ],
      "latent": [
        "latent",
        0
      ],
      "image": [
        "take",
        0
      ],
      "frame_idx": 0,
      "strength": 1,
      "latent_downscale_factor": 1,
      "crop": "disabled",
      "use_tiled_encode": false,
      "tile_size": 256,
      "tile_overlap": 64,
      "attention_strength": 1,
      "use_streaming": false,
      "tile_frames": 97
    },
    "_meta": {
      "title": "Encoding source guidance"
    }
  },
  "audio": {
    "class_type": "LTXVEmptyLatentAudio",
    "inputs": {
      "audio_vae": [
        "audio_vae",
        0
      ],
      "frames_number": [
        "take",
        4
      ],
      "frame_rate": [
        "take",
        5
      ],
      "batch_size": 1
    },
    "_meta": {
      "title": "Preparing audio samples"
    }
  },
  "combine": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": [
        "guide",
        2
      ],
      "audio_latent": [
        "audio",
        0
      ]
    },
    "_meta": {
      "title": "Preparing samples"
    }
  },
  "sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "memory",
        0
      ],
      "positive": [
        "guide",
        0
      ],
      "negative": [
        "guide",
        1
      ],
      "latent_image": [
        "combine",
        0
      ],
      "seed": 42,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "euler_ancestral",
      "scheduler": "linear_quadratic",
      "denoise": 1
    },
    "_meta": {
      "title": "Generating the clean plate"
    }
  },
  "separate": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": [
        "sample",
        0
      ]
    },
    "_meta": {
      "title": "Preparing the result"
    }
  },
  "crop_guides": {
    "class_type": "LTXVCropGuides",
    "inputs": {
      "positive": [
        "guide",
        0
      ],
      "negative": [
        "guide",
        1
      ],
      "latent": [
        "separate",
        0
      ]
    },
    "_meta": {
      "title": "Removing guide frames"
    }
  },
  "decode": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "crop_guides",
        2
      ],
      "vae": [
        "float_vae",
        0
      ],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 128,
      "temporal_overlap": 32
    },
    "_meta": {
      "title": "Decoding the result"
    }
  },
  "save": {
    "class_type": "ZuraPaintoutUncrop",
    "inputs": {
      "decoded_crop": [
        "decode",
        0
      ],
      "plate": [
        "source",
        2
      ],
      "output_name": "paintout/contest",
      "precision": "float32",
      "match_context": false,
      "export_format": "EXR + SDR video",
      "motion_preview": true
    },
    "_meta": {
      "title": "Compositing and saving the shot"
    }
  }
}
