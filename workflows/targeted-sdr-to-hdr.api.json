      "source": "C:/path/to/plate.mp4",
      "colour_space": "srgb_display",
      "pipeline": "sdr_hdr",
      "frame_count": 9,
      "sampling_mode": "tiled_fusion"
    },
    "_meta": {
      "title": "colour_check"
    }
  },
  "source": {
    "class_type": "ZuraPaintoutCrop",
