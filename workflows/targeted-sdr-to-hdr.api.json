        0
      ],
      "negative": [
        "apply_anchors",
        1
      ],
      "latent_image": [
        "combine",
        0
      ],
      "seed": 42,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "euler_ancestral",
      "scheduler": "linear_quadratic",
      "denoise": 1
